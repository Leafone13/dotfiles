#!/bin/bash

# Шпаргалка по tmux: в фокусе стандартные бинды (как на любом сервере),
# бинды Omarchy в конце. P = префикс Ctrl+b.
# Usage: tmux-cheatsheet [--print|-p]

cheatsheet() {
  cat <<'EOF'
PREFIX (P)                       → Ctrl+b
P :                              → Командная строка tmux
P ?                              → Список всех биндов (здесь: эта шпаргалка)
P d                              → Отключиться от сессии (detach)
── СТАНДАРТ · ПАНЕЛИ ──          →
P %                              → Разделить: новая панель справа
P "                              → Разделить: новая панель снизу
P стрелки                        → Перейти в панель по направлению
P o                              → Следующая панель
P ;                              → Предыдущая активная панель
P q                              → Номера панелей, цифра — перейти (здесь: перезагрузка конфига)
P z                              → Развернуть / свернуть панель (zoom)
P x                              → Закрыть панель (здесь: без подтверждения)
P !                              → Вынести панель в отдельное окно
P { / P }                        → Поменять панель местами с соседней
P Space                          → Следующая раскладка
P Alt+1…7                        → Готовые раскладки (Alt+5 — плитка)
P Ctrl+стрелки                   → Изменить размер панели на 1
P Alt+стрелки                    → Изменить размер панели на 5
── СТАНДАРТ · ОКНА ──            →
P c                              → Новое окно
P ,                              → Переименовать окно
P &                              → Закрыть окно (с подтверждением)
P 0…9                            → Перейти к окну по номеру (здесь нумерация с 1)
P n / P p                        → Следующее / предыдущее окно
P l                              → Последнее активное окно
P w                              → Выбор окна из дерева
P '                              → Перейти к окну по введённому номеру
P .                              → Переместить окно (новый номер)
P f                              → Найти панель по тексту
── СТАНДАРТ · СЕССИИ ──          →
tmux                             → Новая сессия (в терминале)
tmux new -s имя                  → Новая сессия с именем
tmux ls                          → Список сессий
tmux a / tmux a -t имя           → Подключиться к последней / к сессии по имени
tmux kill-session -t имя         → Закрыть сессию
P s                              → Выбор сессии из списка
P $                              → Переименовать сессию
P ( / P )                        → Предыдущая / следующая сессия
P L                              → Последняя сессия
── СТАНДАРТ · КОПИРОВАНИЕ (vi) ── →
P [                              → Войти в режим копирования
P PgUp                           → Войти в режим копирования и прокрутить вверх
h j k l / w b / 0 $              → Движение по символам / словам / строке
Ctrl+u / Ctrl+d                  → Полстраницы вверх / вниз
g / G                            → Начало / конец истории
/ и ?                            → Поиск вниз / вверх, n / N — следующий / предыдущий
Space                            → Начать выделение
V                                → Выделить строку
v / Ctrl+v                       → Прямоугольное выделение (здесь v — обычное выделение)
Enter                            → Скопировать выделенное и выйти
q / Esc                          → Выйти / снять выделение
P ]                              → Вставить скопированное
P =                              → Выбрать буфер для вставки
── OMARCHY · ДОПОЛНИТЕЛЬНО ──    →
P q                              → Перезагрузить конфиг tmux
P h / P v                        → Разделить снизу / справа (в текущей папке)
P k / P K                        → Закрыть окно / сессию без подтверждения
P r / P R                        → Переименовать окно / сессию
P C                              → Новая сессия
P P / P N                        → Предыдущая / следующая сессия
Alt+Enter / Alt+Shift+Enter      → Разделить снизу / справа
Alt+Esc                          → Закрыть панель
Ctrl+Alt+стрелки                 → Перейти в панель
Ctrl+Alt+Shift+стрелки           → Изменить размер панели
Alt+1…9                          → Перейти к окну
Alt+← / Alt+→                    → Предыдущее / следующее окно
Alt+Shift+← / Alt+Shift+→        → Сдвинуть окно влево / вправо
Alt+↑ / Alt+↓                    → Предыдущая / следующая сессия
y (копирование)                  → Скопировать выделенное и выйти
EOF
}

if [[ $1 == "--print" || $1 == "-p" ]]; then
  cheatsheet
  exit 0
fi

monitor_height=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .height' 2>/dev/null)

if [[ ! $monitor_height =~ ^[0-9]+$ ]] || ((monitor_height <= 0)); then
  monitor_height=900
fi

cheatsheet | omarchy-menu-select 'Tmux: шпаргалка' -- --width 900 --height $((monitor_height * 60 / 100)) >/dev/null || true
