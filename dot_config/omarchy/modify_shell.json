#!/bin/sh
# Omarchy shell settings, managed here. bar.transparent is runtime state (toggled by double-clicking
# the bar), so it is taken from the live file and never synced.
live=$(cat)
managed=$(cat <<'JSON'
{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "logos.launchpad"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "logos.cheatsheet"
    },
    {
      "id": "logos.launchpad"
    }
  ],
  "version": 1
}
JSON
)
t=$(printf '%s' "$live" | jq -e '.bar.transparent | booleans' 2>/dev/null) || t=
if [ -n "$t" ]; then
  printf '%s\n' "$managed" | jq --argjson t "$t" '.bar.transparent = $t'
else
  printf '%s\n' "$managed" | jq .
fi
