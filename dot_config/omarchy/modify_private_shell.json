#!/bin/sh
# Omarchy shell settings, managed here. The bar look is runtime state (double-clicking the bar cycles
# bar.background: opaque, glassy, none; older Omarchy wrote bar.transparent), so it is taken from the
# live file and never synced.
live=$(cat)
managed=$(cat <<'JSON'
{
  "bar": {
    "layout": {
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "logos.launchpad"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "logos.keys"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Amsterdam",
              "zone": "Europe/Amsterdam"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "logos.cheatsheet"
    },
    {
      "id": "logos.launchpad"
    },
    {
      "id": "io.voxtype.settings"
    }
  ],
  "version": 1
}
JSON
)
look=$(printf '%s' "$live" | jq -c '.bar // {} | with_entries(select(.key == "background" or .key == "transparent"))' 2>/dev/null) || look=
[ -n "$look" ] || look='{}'
printf '%s\n' "$managed" | jq --argjson look "$look" '.bar += $look'
